/* Winter — matches waybar winter.css */
* {
    bg0:     #64727d;  /* wincolor: slate-grey base */
    bg1:     #838c96;  /* bg-1: lighter slate panel */
    bg2:     #292b2c;  /* bghover: dark charcoal, selected item */
    fg0:     #ffffff;  /* text: pure white */
    fg1:     #c8cdd2;  /* muted icy grey, secondary text */
    accent:  rgb(255, 255, 255);  /* batteryplugged: icy blue */
    urgent:  #c83c46;  /* frosty red, for urgent/alert items */
}
